# Costo SV — .gitignore

# Entorno / secretos (hoy no hay; se excluyen por seguridad)
.env
.env.*
!.env.example
*.key
*.pem

# Dependencias (por si se agrega tooling con Node)
node_modules/

# Panel nuevo (Vite) — build y caché
panel/dist/
panel/.vite/
dist/

# Salida del build unificado (build-static.mjs) — se genera en cada deploy
dist_site/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/
.idea/
*.swp
*~

# Logs / temporales
*.log
*.tmp
