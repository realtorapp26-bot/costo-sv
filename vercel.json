{
  "images": {
    "domains": [
      "remaxcaribbeanandcentralamerica.azureedge.net",
      "iseoyfiteeobzvtfjhoe.supabase.co"
    ],
    "sizes": [160, 280, 400, 600, 800, 1080, 1600, 1920],
    "minimumCacheTTL": 604800,
    "formats": ["image/webp"]
  },
  "crons": [
    { "path": "/api/resumen-diario", "schedule": "0 14 * * *" },
    { "path": "/api/chequear-disponibilidad", "schedule": "0 15 * * *" }
  ],
  "rewrites": [
    { "source": "/propiedad/:slug", "destination": "/api/propiedad?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/panel/:path*", "destination": "/panel/index.html" }
  ],
  "redirects": [
    {
      "source": "/franquicias.html",
      "destination": "https://franquicias-retailsolutions.vercel.app/",
      "permanent": true
    },
    {
      "source": "/propiedad",
      "destination": "/propiedades.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/panel.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/propiedades-admin.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/app.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/dossier.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/dossier-golden-lake.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/plano-golden-lake.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/carta-oferta.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/carta-oferta.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/carta-respuesta.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/carta-respuesta.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/agendar-visita.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/agendar-visita.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/login.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/propiedades.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/panel/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/panel/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
